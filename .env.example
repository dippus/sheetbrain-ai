# ==============================================================================
# SheetBrain AI — Multi-Tier Fail-Proof AI Configuration
# ==============================================================================
# SheetBrain AI implements a 3-tier resilient architecture designed for hackathons:
# Tier 1: Cloud Foundation Models (AWS Bedrock Mantle / Claude 3.5 / DeepSeek)
# Tier 2: Open-Source High-Speed AI (Groq / OpenRouter / Ollama)
# Tier 3: Zero-Latency Local Neuro-Symbolic Synthesizer (100% fail-proof, offline)
# ==============================================================================

# 1. AWS Bedrock Configuration
# Canonical model documented in docs/09_AWS_ARCHITECTURE.md and the project
# narrative. Keep this value aligned with the README and evidence register.
BEDROCK_REGION=ap-southeast-2
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# Optional: cheaper/faster for high-volume generation.
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here
# AWS_ACCESS_KEY_ID=your_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# 2. Open-Source AI Providers (Optional — for ultra-fast, zero-failure backup)
# Groq: Generates in ~400ms (Free at console.groq.com)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter: Free open-source models (Free at openrouter.ai)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Ollama: 100% Offline Local LLM (http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
